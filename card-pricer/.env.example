# ── AI Provider ─────────────────────────────────────────────────────────────
# Set AI_PROVIDER to "anthropic" or "openai" to swap without code changes
AI_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=sk-ant-...

# Only needed if AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Market Data ──────────────────────────────────────────────────────────────
# Set to true to use PriceCharting + eBay comps in pricing. false = AI-only (recommended).
# AI-only is faster, avoids wrong-card matches, and uses your booth pricing philosophy.
ENABLE_MARKET_PRICING=false

PRICECHARTING_API_KEY=...

# eBay (set ENABLE_EBAY_TOOL=true to activate)
EBAY_CLIENT_ID=...
EBAY_CLIENT_SECRET=...
EBAY_REFRESH_TOKEN=...
ENABLE_EBAY_TOOL=true

# ── Sandpiper ────────────────────────────────────────────────────────────────
SANDPIPER_USERNAME=...
SANDPIPER_PASSWORD=...
SANDPIPER_ACCOUNT_ID=...
SANDPIPER_BOOTH=...

# ── Google Sheets ────────────────────────────────────────────────────────────
APPS_SCRIPT_WEBHOOK=https://script.google.com/...

# ── Server ───────────────────────────────────────────────────────────────────
LOCAL_IP=10.0.0.66
PORT=8001

# iOS Shortcut name (used for the "scan next" link on success page)
IOS_SHORTCUT_NAME=Card Pricer

DEBUG_LOGS=false

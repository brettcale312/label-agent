# ========================
# 🐍 Python cache / build
# ========================
__pycache__/
*.pyc
*.py[cod]
*.pyo
*.so
*.egg-info/
*.egg
dist/
build/

# ========================
# 🧰 Virtual environments
# ========================
.venv/
env/
venv/

# ========================
# 🔐 Environment variables
# ========================
.env
*.env

# ========================
# 🧾 Logs & runtime files
# ========================
# Ignore all JSON temp data and backups
logs/*.json
logs/temp_*
logs/success_*
logs/*.bak
logs/*.old
*.bak
/logs/
*.log

# Keep only production Sandpiper logs
!logs/sandpiper_*.log
!logs/sandpiper.log

# Ignore other general logs
*.log

# ========================
# 💻 IDE / Editor settings
# ========================
.vscode/
.idea/
*.swp
*.swo

# ========================
# 💾 OS-specific files
# ========================
.DS_Store
Thumbs.db

# ========================
# 📦 Miscellaneous
# ========================
# Backup or temp files
*.tmp
*.old

# ========================
# 📁 Project-specific
# ========================
# Backup folder (captured once, then ignored)
backups/

# Database files (local development)
*.db
*.sqlite
*.sqlite3

# Test images and sample files
test_images/
sample.jpg
test_*.jpg
test_*.png

# Debug and testing scripts
quick_agent_check.py
test_*.py
debug_*.py

# Temporary agent state files
logs/agent_state.json
logs/debug_vision.jpg
patch.diff